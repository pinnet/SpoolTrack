#ifndef CONFIG_H
#define CONFIG_H

// ============================================
// WiFi Configuration
// ============================================
#define WIFI_SSID "YourNetworkName"
#define WIFI_PASSWORD "YourPassword"
#define WIFI_TIMEOUT_MS 20000
#define WIFI_RETRY_DELAY 5000

// ============================================
// Server Configuration
// ============================================
#define SERVER_URL "http://192.168.1.100:3000/api"
#define API_KEY "your-api-key-here"
#define SERVER_TIMEOUT_MS 10000
#define UPDATE_INTERVAL 5000  // How often to check for updates (ms)

// ============================================
// Hardware Pins
// ============================================
// I2C Bus (shared by OLED and PN532)
#define I2C_SDA 21
#define I2C_SCL 22
#define I2C_FREQ 400000  // 400kHz

// Optional buttons
#define BTN_SELECT 4    // GPIO4
#define BTN_PREV 16     // GPIO16
#define BTN_NEXT 17     // GPIO17
#define ENABLE_BUTTONS false  // Set to true if buttons are installed

// Optional LED indicator
#define LED_PIN 2       // Onboard LED
#define ENABLE_LED true

// ============================================
// Display Configuration
// ============================================
#define OLED_WIDTH 128
#define OLED_HEIGHT 64
#define OLED_ADDRESS 0x3C
#define OLED_RESET -1  // Reset pin (-1 if sharing ESP reset)
#define SCREEN_TIMEOUT 30000  // Turn off after 30 seconds (0 = never)
#define SCREEN_BRIGHTNESS 128  // 0-255

// Display driver (uncomment one)
#define USE_SSD1306
// #define USE_SH1106

// ============================================
// NFC Configuration
// ============================================
#define NFC_I2C_ADDRESS 0x24
#define NFC_TIMEOUT 1000  // Tag read timeout (ms)
#define NFC_RETRY_DELAY 500
#define MAX_NFC_RETRIES 3
#define NFC_IRQ_PIN -1  // -1 if not using interrupt pin
#define NFC_RESET_PIN -1  // -1 if not using reset pin

// ============================================
// Application Settings
// ============================================
#define DEVICE_NAME "SpoolTrack"
#define FIRMWARE_VERSION "1.0.0"
#define SERIAL_BAUD 115200

// Cache settings
#define MAX_CACHED_SPOOLS 10
#define CACHE_EXPIRY_HOURS 24

// Offline mode
#define ENABLE_OFFLINE_MODE true
#define OFFLINE_SCAN_LIMIT 50

// ============================================
// OTA Updates
// ============================================
#define ENABLE_OTA true
#define OTA_HOSTNAME "spooltrack"
#define OTA_PASSWORD "admin"  // Change this!
#define OTA_PORT 3232

// ============================================
// Debug Settings
// ============================================
#define DEBUG_MODE true
#define DEBUG_SERIAL true
#define DEBUG_VERBOSE false

// Debug macros
#if DEBUG_MODE
  #define DEBUG_PRINT(x) if(DEBUG_SERIAL) Serial.print(x)
  #define DEBUG_PRINTLN(x) if(DEBUG_SERIAL) Serial.println(x)
  #define DEBUG_PRINTF(x, ...) if(DEBUG_SERIAL) Serial.printf(x, ##__VA_ARGS__)
#else
  #define DEBUG_PRINT(x)
  #define DEBUG_PRINTLN(x)
  #define DEBUG_PRINTF(x, ...)
#endif

// ============================================
// Feature Flags
// ============================================
#define FEATURE_BATTERY_MONITOR false  // Set true if battery is connected
#define FEATURE_SD_CARD false          // Set true if SD card module installed
#define FEATURE_BUZZER false           // Set true if buzzer is connected
#define FEATURE_RTC false              // Set true if RTC module installed

// ============================================
// Battery Monitoring (if enabled)
// ============================================
#if FEATURE_BATTERY_MONITOR
  #define BATTERY_PIN 34  // ADC pin for battery voltage
  #define BATTERY_MIN_VOLTAGE 3.2
  #define BATTERY_MAX_VOLTAGE 4.2
  #define BATTERY_CHECK_INTERVAL 30000  // Check every 30 seconds
#endif

// ============================================
// Advanced Settings
// ============================================
// Memory management
#define MAX_JSON_SIZE 2048
#define MAX_HTTP_RESPONSE_SIZE 4096
#define STACK_SIZE 8192

// Timing
#define WATCHDOG_TIMEOUT 60000  // Reset if frozen for 60s
#define TASK_DELAY_MS 10

// Network
#define HTTP_RETRY_COUNT 3
#define HTTP_RETRY_DELAY 2000

// Display
#define TEXT_SIZE_SMALL 1
#define TEXT_SIZE_MEDIUM 2
#define TEXT_SIZE_LARGE 3

#endif // CONFIG_H
